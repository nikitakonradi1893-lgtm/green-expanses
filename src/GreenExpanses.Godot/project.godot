; Engine configuration file.
; Internal First Playable
config_version=5

[application]
config/name="Зелёные просторы"
run/main_scene="res://Main.tscn"

[display]

[display/window]
size/viewport_width=1440
size/viewport_height=900
size/window_width_override=1440
size/window_height_override=900
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[dotnet]
project/assembly_name="GreenExpanses.Godot"
